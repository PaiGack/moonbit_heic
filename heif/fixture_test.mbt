///|
let hex_digit : (Int32) -> Int32 = fn(code) {
  if code >= 48 && code <= 57 {
    code - 48
  } else if code >= 97 && code <= 102 {
    code - 97 + 10
  } else {
    abort("bad hex digit")
  }
}

///|
let decode : (StringView) -> Bytes = fn(hex) {
  let bytes = Array::makei(hex.length() / 2, fn(i) {
    ((hex_digit(hex.code_unit_at(i * 2).to_int()) << 4) |
    hex_digit(hex.code_unit_at(i * 2 + 1).to_int())).to_byte()
  })
  Bytes::from_array(bytes)
}

///|
/// The parity test reads both kinds of fixture, so both entry points are here.
fn fixtures(path : StringView) -> Bytes {
  decode(hex_of(path))
}

///|
fn tools_fixture(name : String) -> Bytes {
  decode(hex_of("expected_" + name + ".json"))
}

///|
/// A decode that dropped a high bit would show up as the wrong size here.
test "the fixture table decodes to whole bytes" {
  assert_eq(fixtures("minimal.heic").length(), 329)
  assert_eq(tools_fixture("minimal.heic").length(), 517)
}
