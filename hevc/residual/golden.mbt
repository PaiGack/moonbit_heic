// Golden fixtures for the M3 residual-coefficient syntax layer,
// generated by tools/gen_residual_golden.mjs from tools/residual_golden.json
// (the real upstream Go encoder) and held value-for-value against an
// independent JS transcription by tools/crosscheck_residual.mjs.
// The MoonBit residual package must reproduce every value exactly.

///|
/// One scanIndex derivation case.
pub(all) struct ScanIndexCase {
  log2_size : Int32
  c_idx : Int32
  mode : Int32
  intra : Bool
  chroma : Int32
  want : Int32
}

///|
/// One lastSigCoeffCtx derivation case.
pub(all) struct LastCtxCase {
  log2_size : Int32
  c_idx : Int32
  bin_idx : Int32
  want : Int32
}

///|
/// One residual_coding() bitstream produced by the upstream Go encoder,
/// with the coefficient levels it must decode back into.
pub(all) struct ResidualCase {
  log2_size : Int32
  c_idx : Int32
  pred_mode : Int32
  intra : Bool
  sign_hiding : Bool
  bytes : Bytes
  coef : Array[Int32]
}

