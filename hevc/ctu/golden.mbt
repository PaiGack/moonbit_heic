// Golden fixtures for the M3 whole-picture CTU reconstruction.
// Generated by tools/gen_frame_golden.mjs from tools/frame_golden.json
// (the REAL upstream Go decoder, -tags noasm). Each case is a complete
// Annex B I-frame stream plus the exact planar Y/Cb/Cr output; the MoonBit
// decode_i_frame must reproduce every sample. `trace` is the ordered list of
// transform blocks the real codingTreeUnit reconstructed.

///|
/// One transform block the upstream CTU loop reconstructed.
pub(all) struct TbTrace {
  x : Int32
  y : Int32
  log2 : Int32
  c_idx : Int32
  mode : Int32
  cbf : Bool
  qp : Int32
}

///|
/// One whole I frame: stream bytes, expected planar YUV, dimensions, and
/// the transform-block trace (an oracle for debugging bin order).
pub(all) struct FrameCase {
  name : String
  stream : Bytes
  yuv : Bytes
  width : Int32
  height : Int32
  has_ref : Bool
  trace : Array[TbTrace]
}

