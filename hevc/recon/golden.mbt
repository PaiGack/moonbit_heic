// Golden fixtures for the M3 reconstruction DSP layers, generated by
// tools/gen_recon_golden.mjs from an independent from-the-spec
// transcription of each layer (checked value-for-value against the real
// upstream Go implementation during development). The MoonBit recon
// package must reproduce every value exactly.

///|
pub(all) struct DequantCase {
  n : Int32
  qp : Int32
  /// `None` for the flat-16 scaling case.
  m : Array[Int32]?
  coef : Array[Int32]
  want : Array[Int32]
}

///|
pub(all) struct TransformCase {
  n : Int32
  dst : Bool
  coef : Array[Int32]
  want : Array[Int32]
}

///|
pub(all) struct IntraCase {
  n : Int32
  c_idx : Int32
  mode : Int32
  s : Array[Int32]
  want : Array[Int32]
}

///|
pub(all) struct RefCase {
  n : Int32
  mode : Int32
  c_idx : Int32
  strong : Bool
  disabled : Bool
  avail : Array[Bool]
  s : Array[Int32]
  want : Array[Int32]
}

///|
pub(all) struct SubCase {
  size : Int32
  avail : Array[Bool]
  s : Array[Int32]
  want : Array[Int32]
}

