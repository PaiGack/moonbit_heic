// Golden fixtures for the M3 CTU-level CABAC syntax layer.
// Generated by tools/gen_syntax_golden.mjs from tools/syntax_golden.json
// (the real upstream Go code) and held value-for-value against an
// independent JS transcription by tools/crosscheck_syntax.mjs.
// The MoonBit syntax package must reproduce every value exactly.

///|
/// One 8.4.2 MPM candidate derivation case (absent neighbour => -1).
pub(all) struct MpmCase {
  a : Int32
  b : Int32
  want : Array[Int32]
}

///|
/// One 9.3.4.2.2 split_cu_flag ctx derivation case.
pub(all) struct SplitCuCtxCase {
  left_depth : Int32
  above_depth : Int32
  depth : Int32
  want : Int32
}

///|
/// One derived syntax-element context index.
pub(all) struct CtxIdxCase {
  kind : Int32
  arg : Int32
  want : Int32
}

///|
/// One 8.6.1 QP wrap case.
pub(all) struct QpWrapCase {
  pred : Int32
  delta : Int32
  want : Int32
}

///|
/// One sao offset cMax case.
pub(all) struct CMaxCase {
  bit_depth : Int32
  want : Int32
}

///|
/// One prev_intra_luma_pred_flag + rem_intra_luma_pred_mode bitstream.
pub(all) struct LumaCase {
  cand : Array[Int32]
  mode : Int32
  bytes : Bytes
  want : Int32
}

///|
/// One intra_chroma_pred_mode bitstream (idx -1 => direct = luma).
pub(all) struct ChromaCase {
  luma : Int32
  bytes : Bytes
  want : Int32
}

///|
/// One cu_qp_delta_abs / sign bitstream.
pub(all) struct QpdCase {
  bytes : Bytes
  want : Int32
}

///|
/// One cu_chroma_qp_offset bitstream + the PPS offset lists it reads.
pub(all) struct CqoCase {
  len : Int32
  cb_list : Array[Int32]
  cr_list : Array[Int32]
  bytes : Bytes
  want_cb : Int32
  want_cr : Int32
}

///|
/// One intra part_mode bitstream (want: 0 => 2Nx2N, 3 => NxN).
pub(all) struct PartCase {
  bytes : Bytes
  want : Int32
}

///|
/// One single-bin syntax element at a derived context.
pub(all) struct BinCase {
  ctx : Int32
  bytes : Bytes
  want : Int32
}

///|
/// One 7.3.8.3 SAO bitstream with the per-component params it decodes to.
pub(all) struct SaoCase {
  bytes : Bytes
  types : Array[Int32]
  offs : Array[Array[Int32]]
  bands : Array[Int32]
  classes : Array[Int32]
}

